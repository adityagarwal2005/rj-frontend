# The app always calls the API same-origin at /api. That is required for the
# httpOnly auth cookies to be first-party (SameSite=Strict) - pointing this
# straight at the backend origin would make them third-party cookies, which
# Safari blocks and Chrome is phasing out.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api to. Production does the equivalent
# via the rewrite in vercel.json.
VITE_API_PROXY_TARGET=http://localhost:8001
